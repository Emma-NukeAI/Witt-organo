# deploy.env.example — TEMPLATE for the data-inamovible MCP server secrets.
#
# HOW TO USE:  copy this file to  .secrets/deploy.env  (repo root; gitignored) and fill the real values.
#     cp rag_index/mcp_server/deploy.env.example .secrets/deploy.env
#     # then edit .secrets/deploy.env with the values from the founder / the deploy owner
#
# NEVER commit real values (CLAUDE.md §7). The real .secrets/ is gitignored; THIS template holds
# placeholders only. server.py auto-loads .secrets/deploy.env at startup (os.environ.setdefault), so the
# .mcp.json entry carries NO secrets.
#
# REQUIRED for query_data_inamovible (the semantic path):
NEO4J_URI=bolt://<hosted-neo4j-host>:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<ask-the-deploy-owner>
EMBED_MODEL=openai
OPENAI_API_KEY=sk-<your-openai-key>
#
# REQUIRED only for fetch_raw of MIRRORED private/derived data (MinIO). Public source-pointer data
# resolves without these. Safe to leave as placeholders if you only use query + resolve:
MINIO_ENDPOINT=<minio-host>:9000
MINIO_ACCESS_KEY=<ask-the-deploy-owner>
MINIO_SECRET_KEY=<ask-the-deploy-owner>
MINIO_SECURE=false
#
# NOT used by the MCP server itself (it's for agent reasoning elsewhere); include if your workflow needs it:
ANTHROPIC_API_KEY=sk-ant-<your-anthropic-key>
